+    # A previous process using the same key may have left transactions
+    # pending. Some clients (skaled) report only the executed nonce and
+    # reject same-nonce replacements, so starting from a stale value
+    # collides with them. Wait until the nonce stays unchanged for a full
+    # block interval before trusting it.
+    stable_since = time.monotonic()
+    drain_deadline = time.monotonic() + 30
+    last_nonce = seed_key.nonce
+    while time.monotonic() < drain_deadline:
+        if time.monotonic() - stable_since >= 12:
+            break
+        time.sleep(1)
+        current = Number(
+            eth_rpc.get_account(seed_key, skip_code=True).nonce
+        )
+        if current != last_nonce:
+            logger.info(
+                f"Seed nonce advanced {last_nonce} -> {current}; "
+                "waiting for pending transactions to drain"
+            )
+            last_nonce = current
+            stable_since = time.monotonic()
+    seed_key.nonce = last_nonce
+
     # Record the start balance of the worker key
     start_balance = seed_account.balance
 
